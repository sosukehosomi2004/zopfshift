generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== 従業員 =====
model Employee {
  id              String         @id @default(cuid())
  // 雇用形態(F=正社員/P=パート) + 勤務場所(F=工場/C=カフェ/H=フロア/O=事務/X=その他) + 通し3桁。
  // 例: FF001, PC003。退職者は旧番号(数字のみ)のまま残ることがある。
  employeeNumber  String         @unique
  lastName        String
  firstName       String
  lastNameRomaji  String
  firstNameRomaji String
  password        String
  mustChangePassword Boolean      @default(false)
  role            EmployeeRole   @default(STAFF)
  employmentType  EmploymentType
  primaryWorkplace Workplace
  floorProficiency Proficiency?  // フロアで働ける従業員のフロア習熟度
  isActive        Boolean        @default(true)
  retiredAt       DateTime?      @db.Date  // 退職日 (この日まで勤務、翌日からシフト対象外)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  secondaryWorkplaces EmployeeSecondaryWorkplace[]
  availableShiftTimes EmployeeShiftTime[]
  skills              EmployeeSkill[]
  dayOffRequests      DayOffRequest[]
  shiftAssignments    ShiftAssignment[]
  preAssignments      PreAssignment[]
  recurringRules      EmployeeRecurringRule[]
  notifications       Notification[]
}

// 通年固定ルール: 「毎週月曜は休み」「毎週金曜は工場で出勤」など
model EmployeeRecurringRule {
  id          String            @id @default(cuid())
  employeeId  String
  // 条件 (dayOfWeek または dayCategory のどちらか1つをセット)
  dayOfWeek       Int?              // 0=日 〜 6=土
  dayCategory     DayCategory?      // 種別ベース
  // 曜日指定時のみ: 祝日を除外するか (true=除外 / false=含む)
  excludeHolidays Boolean?
  // アクション
  ruleType    RecurringRuleType
  workplace   Workplace?        // ALWAYS_WORKのとき: 勤務先 (null=primary)
  memo        String?
  createdAt   DateTime          @default(now())

  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

enum RecurringRuleType {
  ALWAYS_OFF
  ALWAYS_WORK
}

enum DayCategory {
  HOLIDAY              // 祝日のみ
  WEEKEND_OR_HOLIDAY   // 休日 = 土日 + 祝日
  WEEKDAY              // 平日 = 月〜金 (祝日除く)
}

enum EmployeeRole {
  ADMIN
  STAFF
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum Workplace {
  FACTORY
  CAFE
  FLOOR
  L
  F       // フリー枠 (熟練者・新入りに与えられる。稼働人数には含めない)
  OFFICE
  OTHER
}

enum ShiftTimeSlot {
  EARLY
  DAYTIME
  CLOSE
}

// 習熟度 ▲(LOW) / ○(MID) / ◎(HIGH)
enum Proficiency {
  LOW
  MID
  HIGH
}

// 従業員の移動可能な勤務場所
model EmployeeSecondaryWorkplace {
  id         String    @id @default(cuid())
  employeeId String
  workplace  Workplace
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workplace])
}

// パート従業員の対応可能な時間帯
model EmployeeShiftTime {
  id         String        @id @default(cuid())
  employeeId String
  timeSlot   ShiftTimeSlot
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, timeSlot])
}

// ===== スキル（ポジション） =====
model Skill {
  id        String    @id @default(cuid())
  workplace Workplace
  name      String
  sortOrder Int       @default(0)

  employeeSkills EmployeeSkill[]
  slotSkills     WorkplaceSlotSkill[]

  @@unique([workplace, name])
}

// 従業員が持つスキル
model EmployeeSkill {
  id          String       @id @default(cuid())
  employeeId  String
  skillId     String
  proficiency Proficiency? // カフェK/S用。他のスキルはnull
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
}

// ===== 勤務場所の定数設定 =====

// 勤務場所 x 曜日タイプ別の必要人数
model WorkplaceStaffingRule {
  id                String    @id @default(cuid())
  workplace         Workplace
  dayType           DayType
  requiredCount     Int
  minFullTimeCount  Int?
  baseFullTimeCount Int?

  @@unique([workplace, dayType])
}

enum DayType {
  WEEKDAY_MON_THU
  FRIDAY
  HOLIDAY
}

// 勤務場所のポジションスロット定義（工場の10スロットなど）
model WorkplaceSlot {
  id        String    @id @default(cuid())
  workplace Workplace
  name      String
  sortOrder Int

  skills WorkplaceSlotSkill[]
  rules  WorkplaceSlotRule[]

  @@unique([workplace, name])
}

// スロットに必要なスキル
model WorkplaceSlotSkill {
  id              String        @id @default(cuid())
  workplaceSlotId String
  skillId         String
  workplaceSlot   WorkplaceSlot @relation(fields: [workplaceSlotId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([workplaceSlotId, skillId])
}

// スロットの曜日タイプ別ルール
model WorkplaceSlotRule {
  id              String        @id @default(cuid())
  workplaceSlotId String
  dayType         DayType
  isRequired      Boolean       @default(true)
  groupKey        String?

  workplaceSlot WorkplaceSlot @relation(fields: [workplaceSlotId], references: [id], onDelete: Cascade)

  @@unique([workplaceSlotId, dayType])
}

// ===== 公休数設定 =====
model MonthlyHolidayConfig {
  id           String @id @default(cuid())
  fiscalYear   Int
  month        Int
  holidayCount Int

  @@unique([fiscalYear, month])
}

// ===== 休み希望・有休申請 =====
model DayOffRequest {
  id         String        @id @default(cuid())
  employeeId String
  date       DateTime      @db.Date
  type       DayOffType
  status     RequestStatus @default(PENDING)
  memo       String?
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([employeeId, date])
}

enum DayOffType {
  DAY_OFF
  PAID_LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===== 申請受付ウィンドウ =====
// シフト期間 (ShiftPeriod) とは独立した、休み申請の受付窓口管理。
// 「2026年6月度の申請を 4/30 まで受け付ける」のような運用をサポート。
model RequestWindow {
  id              String   @id @default(cuid())
  fiscalYear      Int
  month           Int      // 1-12 (label の月、例: 6 → 6月度 = 5/21~6/20)
  deadline        DateTime // 申請期限 (日時、例: 2026-04-30 23:59)
  weekdayCapacity Int      @default(6)  // 平日のソフト警告閾値 (達すると「希望者多数」表示。申請はブロックしない)
  holidayCapacity Int      @default(4)  // 休日のソフト警告閾値
  // 個別日の警告閾値上書き: { "YYYY-MM-DD": 数字 }
  thresholdOverrides Json  @default("{}")
  // 管理者からのメッセージ (期間付き):
  // [{ startDate: "YYYY-MM-DD", endDate: "YYYY-MM-DD", body: "メッセージ本文" }]
  messages        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fiscalYear, month])
}

// ===== シフト期間・生成・確定 =====

model ShiftPeriod {
  id        String       @id @default(cuid())
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  label     String
  status    PeriodStatus @default(DRAFT)
  // シフト生成押下直前の PreAssignment 状態のスナップショット
  // 「下書きに戻す」で復元するために保持。型: [{employeeId, date, workplace, memo, color}]
  draftSnapshot Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  candidates     ShiftCandidate[]
  preAssignments PreAssignment[]
}

// 自動生成前に管理者が確定したシフト（生成時に固定される）
model PreAssignment {
  id            String      @id @default(cuid())
  shiftPeriodId String
  employeeId    String
  date          DateTime    @db.Date
  workplace     Workplace?  // null = 休み確定
  memo          String?
  color         String?     // セル背景の上書き色（プリセットキー: red/orange/yellow/green/blue/purple/pink/gray）

  shiftPeriod   ShiftPeriod @relation(fields: [shiftPeriodId], references: [id], onDelete: Cascade)
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([shiftPeriodId, employeeId, date])
}

// 事前確定の取消マーク
// 管理者が「事前確定を取り消す」を押した時に記録される。
// expandRecurringRules や 申請承認時の自動 upsert はこのテーブルにある日付をスキップする。
// 通常のPreAssignment作成 (手動入力 or 申請承認の自動upsert) でこのマークは解除される。
model PreAssignmentExclusion {
  id            String   @id @default(cuid())
  shiftPeriodId String
  employeeId    String
  date          DateTime @db.Date
  createdAt     DateTime @default(now())

  @@unique([shiftPeriodId, employeeId, date])
}

enum PeriodStatus {
  DRAFT
  GENERATING
  ADJUSTING  // 自動生成後・手動調整中 (編集可)
  CONFIRMED  // 最終確定 (編集不可)
}

// 生成されたシフト候補
model ShiftCandidate {
  id             String      @id @default(cuid())
  shiftPeriodId  String
  candidateIndex Int
  score          Float?
  isSelected     Boolean     @default(false)
  violations     Json?       // SOFT違反のリスト（定数不足、ポジション未充足）
  shiftPeriod    ShiftPeriod @relation(fields: [shiftPeriodId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  assignments ShiftAssignment[]

  @@unique([shiftPeriodId, candidateIndex])
}

// 日ごとの出勤割当
model ShiftAssignment {
  id               String         @id @default(cuid())
  shiftCandidateId String
  employeeId       String
  date             DateTime       @db.Date
  workplace        Workplace?     // null = 休み
  workplaceSlotId  String?
  shiftTimeSlot    ShiftTimeSlot?
  isMoved          Boolean        @default(false)
  memo             String?        // 1文字メモ（手動調整用）
  color            String?        // セル背景の上書き色（プリセットキー）

  shiftCandidate ShiftCandidate @relation(fields: [shiftCandidateId], references: [id], onDelete: Cascade)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([shiftCandidateId, employeeId, date])
}

// ===== 祝日マスタ =====
model Holiday {
  id   String   @id @default(cuid())
  date DateTime @db.Date @unique
  name String
}

// ===== 通知 =====
model Notification {
  id         String   @id @default(cuid())
  employeeId String
  type       String
  message    String
  read       Boolean  @default(false)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
